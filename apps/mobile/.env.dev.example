EXPO_PUBLIC_APP_ENV=dev
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5089
EXPO_PUBLIC_AUTH_EMULATOR_URL=http://10.0.2.2:9099

# Native Google OAuth IDs; never substitute raw Google tokens for Firebase ID tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
MONOKEY_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_AUTH_CONTINUE_URL=
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false

# Enable only after physical-device security and signing review.
EXPO_PUBLIC_NATIVE_AUTOFILL_REVIEWED=false
