{
  "cli": {
    "version": "16.28.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev"
      }
    },
    "test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod"
      }
    }
  }
}
