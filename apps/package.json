{
  "name": "monokey-clients",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "mobile",
    "extension",
    "marketing"
  ],
  "scripts": {
    "build": "npm run build --workspace @monokey/contracts && npm run build --workspace @monokey/crypto && npm run build --workspace @monokey/web && npm run build --workspace @monokey/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "uuid": "11.1.1"
  },
  "overrides": {
    "uuid": "$uuid",
    "@grpc/grpc-js": "1.14.5",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  }
}
